index 817ec51..0598793 100644
--- a/src/dynarmic/common/spin_lock_arm64.cpp
+++ b/src/dynarmic/common/spin_lock_arm64.cpp
@@ -18,6 +18,21 @@ using Backend::Arm64::Wscratch1;
 using namespace oaknut::util;
 
 void EmitSpinLockLock(oaknut::CodeGenerator& code, oaknut::XReg ptr) {
+#if defined(__SWITCH2__)
+    // No SEVL/WFE here. Measured on Switch 2: the pair costs about 20 ns, and every guest
+    // LDREX/STREX takes this lock twice. In a scene that leans on atomics (Majora's Mask
+    // 3D, the Sheikah stone's visions list: ~170 000 pairs per frame) dropping it was
+    // worth about 10% - a small part of that slowdown, not its cause. The lock is held
+    // for a few instructions, so spinning is the right wait anyway.
+    oaknut::Label loop;
+
+    code.MOV(Wscratch1, 1);
+    code.l(loop);
+    code.LDAXR(Wscratch0, ptr);
+    code.CBNZ(Wscratch0, loop);
+    code.STXR(Wscratch0, Wscratch1, ptr);
+    code.CBNZ(Wscratch0, loop);
+#else
     oaknut::Label start, loop;
 
     code.MOV(Wscratch1, 1);
@@ -29,6 +44,7 @@ void EmitSpinLockLock(oaknut::CodeGenerator& code, oaknut::XReg ptr) {
     code.CBNZ(Wscratch0, start);
     code.STXR(Wscratch0, Wscratch1, ptr);
     code.CBNZ(Wscratch0, loop);
+#endif
 }
 
