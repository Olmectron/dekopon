+#include <atomic>
 #include <mutex>
 
 #include <oaknut/code_block.hpp>
@@ -18,6 +19,21 @@ using Backend::Arm64::Wscratch1;
 using namespace oaknut::util;
 
 void EmitSpinLockLock(oaknut::CodeGenerator& code, oaknut::XReg ptr) {
+#if defined(__SWITCH__)
+    // No SEVL/WFE here. Measured on Switch 2: the pair costs about 20 ns, and every guest
+    // LDREX/STREX takes this lock twice. In a scene that leans on atomics (Majora's Mask
+    // 3D, the Sheikah stone's visions list: ~170 000 pairs per frame) dropping it was
+    // worth about 10% - a small part of that slowdown, not its cause. The lock is held
+    // for a few instructions, so spinning is the right wait anyway.
+    oaknut::Label loop;
+
+    code.MOV(Wscratch1, 1);
+    code.l(loop);
+    code.LDAXR(Wscratch0, ptr);
+    code.CBNZ(Wscratch0, loop);
+    code.STXR(Wscratch0, Wscratch1, ptr);
+    code.CBNZ(Wscratch0, loop);
+#else
     oaknut::Label start, loop;
 
     code.MOV(Wscratch1, 1);
@@ -29,6 +45,7 @@ void EmitSpinLockLock(oaknut::CodeGenerator& code, oaknut::XReg ptr) {
     code.CBNZ(Wscratch0, start);
     code.STXR(Wscratch0, Wscratch1, ptr);
     code.CBNZ(Wscratch0, loop);
+#endif
 }
 
 void EmitSpinLockUnlock(oaknut::CodeGenerator& code, oaknut::XReg ptr) {
@@ -51,6 +68,19 @@ struct SpinLockImpl {
 
 std::once_flag flag;
 SpinLockImpl impl;
+// Set once the lock and unlock routines exist. std::call_once on every Lock() and Unlock()
+// is not free everywhere: measured on Switch 2 it made a guest LDREX/STREX pair cost about
+// 600 ns (four call_once per pair), against some 70 ns for everything else on that path.
+std::atomic<bool> impl_ready{false};
+
+void EnsureInitialized() {
+    if (!impl_ready.load(std::memory_order_acquire)) [[unlikely]] {
+        std::call_once(flag, [] {
+            impl.Initialize();
+            impl_ready.store(true, std::memory_order_release);
+        });
+    }
+}
 
 SpinLockImpl::SpinLockImpl()
         : mem{4096}
@@ -74,12 +104,24 @@ void SpinLockImpl::Initialize() {
 }  // namespace
 
 void SpinLock::Lock() {
-    std::call_once(flag, &SpinLockImpl::Initialize, impl);
+#if defined(__SWITCH__)
+    // The only user of this lock is the exclusive monitor, and on the consoles every
+    // emulated core runs on the one emulation thread, in turn: there is nobody to keep
+    // out. Taking it cost two calls into generated code and two atomic round trips per
+    // guest LDREX or STREX - 170 000 pairs a frame in Majora's Mask 3D's visions list.
+    return;
+#else
+    EnsureInitialized();
     impl.lock(&storage);
+#endif
 }
 
 void SpinLock::Unlock() {
-    std::call_once(flag, &SpinLockImpl::Initialize, impl);
+#if defined(__SWITCH__)
+    return;
+#else
+    EnsureInitialized();
     impl.unlock(&storage);
+#endif
 }
 
