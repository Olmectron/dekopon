+
+template<typename ProgramCounterType>
+void BlockRangeInformation<ProgramCounterType>::Reap(size_t intervals) {
+    while (intervals > 0 && !dropped.empty()) {
+        RangeMap& map = dropped.back();
+        if (map.empty()) {
+            dropped.pop_back();
+            continue;
+        }
+        map.erase(map.begin());
+        --intervals;
+    }
 }
 
