new file mode 100644
index 0000000..aa7c0d1
--- /dev/null
+++ b/src/dynarmic/backend/arm64/block_arena.h
@@ -0,0 +1,146 @@
+/* This file is part of the dynarmic project.
+ * SPDX-License-Identifier: 0BSD
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdlib>
+#include <functional>
+#include <new>
+#include <utility>
+#include <vector>
+
+namespace Dynarmic::Backend::Arm64 {
+
+/// Memory for the per-block bookkeeping of one address space (relocations, fastmem patch
+/// tables, back references), handed out by bumping a pointer and taken back all at once.
+///
+/// That bookkeeping is millions of small allocations by the time the code cache is full.
+/// Freeing them one by one when the cache is dropped took about 25 seconds on a Switch,
+/// with the guest frozen. From here they cost nothing to free: dropping the cache rewinds
+/// the arena. What a container outgrows is not reused until then.
+class BlockArena {
+public:
+    BlockArena() = default;
+    BlockArena(const BlockArena&) = delete;
+    BlockArena& operator=(const BlockArena&) = delete;
+    ~BlockArena() {
+        for (void* chunk : chunks) {
+            std::free(chunk);
+        }
+        for (void* block : large) {
+            std::free(block);
+        }
+    }
+
+    void* Allocate(std::size_t bytes, std::size_t align) {
+        if (bytes > CHUNK / 4) {
+            void* block = std::malloc(bytes);
+            if (block == nullptr) {
+                throw std::bad_alloc{};
+            }
+            large.push_back(block);
+            large_bytes += bytes;
+            return block;
+        }
+        offset = (offset + align - 1) & ~(align - 1);
+        if (current == chunks.size() || offset + bytes > CHUNK) {
+            if (current < chunks.size()) {
+                ++current;
+            }
+            if (current == chunks.size()) {
+                void* chunk = std::malloc(CHUNK);
+                if (chunk == nullptr) {
+                    throw std::bad_alloc{};
+                }
+                chunks.push_back(chunk);
+            }
+            offset = 0;
+        }
+        void* out = static_cast<char*>(chunks[current]) + offset;
+        offset += bytes;
+        return out;
+    }
+
+    /// Everything handed out is gone. The chunks are kept for the next round.
+    void Reset() {
+        for (void* block : large) {
+            std::free(block);
+        }
+        large.clear();
+        large_bytes = 0;
+        current = 0;
+        offset = 0;
+    }
+
+    std::size_t Used() const {
+        return current * CHUNK + offset + large_bytes;
+    }
+
+    /// The arena allocations on this thread go to, while one of these is alive.
+    class Scope {
+    public:
+        explicit Scope(BlockArena& arena) : previous{Current()} {
+            Current() = &arena;
+        }
+        ~Scope() {
+            Current() = previous;
+        }
+        Scope(const Scope&) = delete;
+        Scope& operator=(const Scope&) = delete;
+
+    private:
+        BlockArena* previous;
+    };
+
+    static BlockArena*& Current() {
+        static thread_local BlockArena* current_arena = nullptr;
+        return current_arena;
+    }
+
+private:
+    static constexpr std::size_t CHUNK = 1024 * 1024;
+
+    std::vector<void*> chunks;
+    std::vector<void*> large;
+    std::size_t large_bytes = 0;
+    std::size_t current = 0;
+    std::size_t offset = 0;
+};
+
+/// Allocates from the current thread's arena; frees nothing. Outside any arena's scope it
+/// falls back to the heap, and that memory is never returned (it does not happen in practice:
+/// every path that fills these containers runs inside a scope).
+template<typename T>
+struct ArenaAllocator {
+    using value_type = T;
+
+    ArenaAllocator() noexcept = default;
+    template<typename U>
+    ArenaAllocator(const ArenaAllocator<U>&) noexcept {}
+
+    T* allocate(std::size_t n) {
+        const std::size_t align = alignof(T) > alignof(std::max_align_t) ? alignof(T) : alignof(std::max_align_t);
+        if (BlockArena* arena = BlockArena::Current()) {
+            return static_cast<T*>(arena->Allocate(n * sizeof(T), align));
+        }
+        void* out = std::malloc(n * sizeof(T));
+        if (out == nullptr) {
+            throw std::bad_alloc{};
+        }
+        return static_cast<T*>(out);
+    }
+    void deallocate(T*, std::size_t) noexcept {}
+
+    template<typename U>
+    bool operator==(const ArenaAllocator<U>&) const noexcept {
+        return true;
+    }
+    template<typename U>
+    bool operator!=(const ArenaAllocator<U>&) const noexcept {
+        return false;
+    }
+};
+
+}  // namespace Dynarmic::Backend::Arm64
